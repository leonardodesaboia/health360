# Local Docker development only. Copy to .env; never use these credentials on a VPS.
POSTGRES_USER=health360
POSTGRES_PASSWORD=health360_dev_only
POSTGRES_DB=health360
DATABASE_URL=postgresql://health360:health360_dev_only@127.0.0.1:5432/health360

# Future server-only integration; the foundation does not read these variables.
# All database/provider values are server-only. Never prefix secrets with NEXT_PUBLIC_.
LLM_PROVIDER=openai
# OpenAI "Astra": https://developers.openai.com/api/docs/models
LLM_MODEL=gpt-6-astra
OPENAI_API_KEY=
LLM_TIMEOUT_MS=30000
