# Local Docker development only. Copy to .env; never use these credentials on a VPS.
POSTGRES_USER=health360
POSTGRES_PASSWORD=health360_dev_only
POSTGRES_DB=health360
DATABASE_URL=postgresql://health360:health360_dev_only@127.0.0.1:5432/health360

# Server-only LLM adapter. mock is explicit test/demo mode; it is never an error fallback.
# All database/provider values are server-only. Never prefix secrets with NEXT_PUBLIC_.
LLM_PROVIDER=mock
# Force offline demo mode with LLM_PROVIDER=mock, even if an API key is present.
# Unset provider also defaults to mock. Explicit openai requires a key and model;
# invalid OpenAI configuration or API failures never fall back to mock.
LLM_MODEL=deterministic-v1
# For explicit LLM_PROVIDER=openai, set LLM_MODEL=gpt-6-astra and supply the key.
# OpenAI "Astra": https://developers.openai.com/api/docs/models
OPENAI_API_KEY=
LLM_TIMEOUT_MS=30000

# Disposable integration database only; never point this at a production database.
TEST_DATABASE_URL=postgresql://health360:health360_dev_only@127.0.0.1:5432/health360_tests

# Override on shared machines if 5432 is in use; update both database URLs as well.
POSTGRES_PORT=5432

# Explicit manual live connectivity smoke only; ignored when CI is set.
LLM_LIVE_SMOKE=0

# Enable for HTTPS demo deployments; local HTTP preview/CI use false.
DEMO_COOKIE_SECURE=false
